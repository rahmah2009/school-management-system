# Local development
PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:password@localhost:5432/greenfield_school
DATABASE_SSL=false

# Generate a unique random secret of at least 32 characters for JWT signing.
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters

# Comma-separated frontend origins; include your actual production frontend URL.
CORS_ORIGINS=http://localhost:5173,https://school-management-system-phi-lovat.vercel.app
